{
  "name": "openobec",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:marketing": "pnpm --filter @openobec/marketing dev",
    "dev:citizen": "pnpm --filter @openobec/citizen dev",
    "dev:office": "pnpm --filter @openobec/office dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages tests/e2e",
    "test:frontend": "tsx --test packages/api-client/test/*.test.ts",
    "test:e2e": "playwright test",
    "generate:client": "openapi-typescript contracts/openapi.yaml -o packages/api-client/src/schema.d.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
