# Local synthetic demo values only. Copy to .env. All published ports bind localhost.
COMPOSE_PROJECT_NAME=openobec
OBEC_ID=zilina
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:29092
S3_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=openobec-demo
S3_SECRET_KEY=openobec-local-demo-secret
S3_BUCKET=openobec-documents
S3_REGION=us-east-1
QUERY_CURSOR_SECRET=openobec-local-cursor-key-change-outside-demo
API_INTERNAL_URL=http://localhost:8080
API_DOCKER_URL=http://api-gateway:8080
MARKETING_URL=http://localhost:3000
CITIZEN_URL=http://localhost:3001
OFFICE_URL=http://localhost:3002
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m
MONGODB_INVOICES_URI=mongodb://localhost:27017/openobec_invoices?replicaSet=rs-invoices&directConnection=true
MONGODB_SUPPLIER_INVOICES_URI=mongodb://localhost:27018/openobec_supplier_invoices?replicaSet=rs-supplier-invoices&directConnection=true
MONGODB_CONTRACTS_URI=mongodb://localhost:27019/openobec_contracts?replicaSet=rs-contracts&directConnection=true
MONGODB_ORDERS_URI=mongodb://localhost:27020/openobec_orders?replicaSet=rs-orders&directConnection=true
MONGODB_PROCUREMENT_URI=mongodb://localhost:27021/openobec_procurement?replicaSet=rs-procurement&directConnection=true
MONGODB_ORDINANCES_URI=mongodb://localhost:27022/openobec_ordinances?replicaSet=rs-ordinances&directConnection=true
MONGODB_READ_URI=mongodb://localhost:27023/openobec_read?replicaSet=rs-read&directConnection=true
# Container equivalents: change localhost:host-port to the owning DNS host:27017.
MONGODB_INVOICES_INTERNAL_URI=mongodb://mongo-invoices:27017/openobec_invoices?replicaSet=rs-invoices
MONGODB_SUPPLIER_INVOICES_INTERNAL_URI=mongodb://mongo-supplier-invoices:27017/openobec_supplier_invoices?replicaSet=rs-supplier-invoices
MONGODB_CONTRACTS_INTERNAL_URI=mongodb://mongo-contracts:27017/openobec_contracts?replicaSet=rs-contracts
MONGODB_ORDERS_INTERNAL_URI=mongodb://mongo-orders:27017/openobec_orders?replicaSet=rs-orders
MONGODB_PROCUREMENT_INTERNAL_URI=mongodb://mongo-procurement:27017/openobec_procurement?replicaSet=rs-procurement
MONGODB_ORDINANCES_INTERNAL_URI=mongodb://mongo-ordinances:27017/openobec_ordinances?replicaSet=rs-ordinances
MONGODB_READ_INTERNAL_URI=mongodb://mongo-read:27017/openobec_read?replicaSet=rs-read
